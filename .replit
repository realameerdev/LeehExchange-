modules = ["python-3.11"]

[nix]
channel = "stable-24_05"
packages = ["glibcLocales"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "LEEH Telegram Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "LEEH Admin Dashboard"

[[workflows.workflow]]
name = "LEEH Telegram Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python telegram_bot.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "LEEH Admin Dashboard"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python app.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
expertMode = true
integrations = ["replitmail:1.0.0"]

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "vm"
run = ["python", "run_services.py"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
